# GENERATED by tools/build.py from site.env (DOMAINS, WEBROOT) and _headers.
# do not edit this file: edit those, then run python3 tools/build.py
#
# use it from the main caddy config (/etc/caddy/Caddyfile), one line:
#     import /srv/lynnux/deploy/Caddyfile
# then: systemctl reload caddy
# caddy gets and renews the https certificates for every name below by itself.
# needs: DNS A (and AAAA) records for lynnux.ch, www.lynnux.ch, lynnux.li, www.lynnux.li pointing here, ports 80 and 443 open.

(lynnux_headers) {
	header {
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' blob: data:; media-src 'self' blob:; font-src 'self'; connect-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		X-Frame-Options "DENY"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}

lynnux.ch, lynnux.li {
	root * /srv/lynnux/dist
	encode zstd gzip
	import lynnux_headers
	@lynnux_p0 path /assets/fonts/*
	header @lynnux_p0 Cache-Control "public, max-age=31536000, immutable"
	file_server
	# anything missing gets the 404 page (with a real 404 status)
	handle_errors {
		import lynnux_headers
		rewrite * /404.html
		file_server
	}
}

www.lynnux.ch {
	redir https://lynnux.ch{uri} permanent
}

www.lynnux.li {
	redir https://lynnux.li{uri} permanent
}
