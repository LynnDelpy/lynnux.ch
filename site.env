# site.env :: everything that makes this site yours, in one place.
#
#   1. edit this file
#   2. python3 tools/build.py                 writes js/config.js (+ title, description, CNAME,
#                                             and the web server configs in deploy/)
#   3. your own copy of the site? also run:   python3 tools/build_evidence.py --new
#      (fresh flags + evidence. keep the flags.json it writes, never commit it)
#
# treat this file as PUBLIC: it gets committed to git. no secrets in here.
#
# syntax: KEY=value. use "double quotes" for values with # in them or for
# multi-line text. an empty value hides that thing on the site.
# {domain} anywhere in a value becomes the domain the visitor is using.


# ------------------------------------------------------------------ the site

# short name: page title, the man pages, browser storage prefix
SITE_NAME=lynnux

# every domain the site is served on. the site uses whichever one the visitor
# typed: the prompt, the caution tape and the title follow it. subdomains count
# as their base domain (www.lynnux.li -> lynnux.li). the first one is the
# default for anything else (localhost, preview urls).
DOMAINS=lynnux.ch,lynnux.li

DESCRIPTION="a forensic workstation in your browser. portfolio, links, and real forensics challenges you can solve right here."
TAGLINE="digital forensics · ctf · linux"
LOCATION=switzerland

# the (fictional) owner of the machine: owns the evidence, runs the hashcat
# jobs, has a command named after them. must be a unix username.
OWNER=lucia

# flags look like lynnux{...}. after changing this: python3 tools/build_evidence.py --new
FLAG_PREFIX=lynnux

# github pages can serve only ONE custom domain. set it here and the build
# writes the CNAME file for you. cloudflare pages / netlify serve every domain
# in DOMAINS without it, so leave it empty there.
CNAME=

# your own server: the folder the web server serves. that is the dist/ inside
# the git checkout on the server (python3 tools/build.py --dist fills it).
# used in the generated deploy/Caddyfile and deploy/nginx.conf
WEBROOT=/srv/lynnux/dist


# ------------------------------------------------------------------ links
# any LINK_<NAME>=https://... shows up as <name> in ~/links, `contact` and
# the plain view. empty = hidden.

LINK_GITHUB=https://github.com/LynnDelpy
LINK_CTFTIME=
LINK_MASTODON=
LINK_TWITTER=
LINK_LINKEDIN=
LINK_BLOG=

# e.g. hi@{domain} -> hi@lynnux.ch for .ch visitors, hi@lynnux.li for .li
EMAIL=
# copied to the clipboard when clicked
DISCORD=
# comma separated
TEAMS=


# ------------------------------------------------------------------ about.txt
# shown by `about`, `cat ~/about.txt` and the plain view

ABOUT="hi :)

i do digital forensics, mostly in ctfs: disk images, memory dumps,
packet captures, and files that pretend to be other files.
based in switzerland. i use arch, btw.

this site is a forensic workstation. ~/cases has real challenges:
real files you can solve right here in the browser, or download
and throw at your own tools. everything you need is on this machine."


# ------------------------------------------------------------------ writeups
# listed in ~/writeups. WRITEUP_<number>="title | https://url"
# WRITEUP_1="dns tunnels at some ctf | https://example.com/writeup"


# ------------------------------------------------------------------ fastfetch / hyfetch
# the flag hyfetch paints the logo with: lesbian, rainbow, transgender,
# nonbinary, bisexual, pansexual, asexual, aromantic, agender, genderfluid, gay-men
HYFETCH_PRESET=lesbian

# the machine is... aspirational. keep values under ~55 chars or they wrap.
# os, kernel, cpu, gpu, mem, swap, disk and shell are required.
MACHINE_OS=Arch Linux x86_64
MACHINE_KERNEL=6.17.2-arch1-1
MACHINE_HOST=a 42U rack in the living room
MACHINE_DISPLAY="3x 5120x2160 @ 240 Hz (one is just for htop)"
MACHINE_CPU="AMD Ryzen Threadripper PRO 9995WX (192) @ 5.40 GHz"
MACHINE_GPU="4x NVIDIA RTX PRO 6000 Blackwell (96 GB each)"
MACHINE_MEM=1.00 TiB
MACHINE_SWAP=2.00 TiB
MACHINE_DISK=64.0 TiB
MACHINE_POWER="2.4 kW at idle (the lights flicker)"
MACHINE_TEMP="31°C (LN2, plus a swiss basement)"
MACHINE_SHELL=zsh 5.9
# match what `plasmashell --version` says
MACHINE_DE=KDE Plasma 6.5
MACHINE_WM=KWin (Wayland)
MACHINE_THEME="started as Breeze, long ago [Qt]"
MACHINE_TERMINAL=
